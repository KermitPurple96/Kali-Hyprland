# Wofi -- the FALLBACK launcher (SUPER+D prefers fuzzel; see
# ~/.config/hypr/scripts/launcher.sh).
#
# Geometry now mirrors i3-kitty's rofi/config.rasi rather than kali-clean's
# old rofi config:  window width 480, listview lines 8, columns 1.
#
# That is also the performance fix. The previous settings asked for a
# 3-column, 15-line grid -- 45 entries laid out and repainted on every
# keystroke -- and `matching=fuzzy`, which rescores all ~345 desktop
# entries each time. On llvmpipe that is what made typing stutter.
show=drun
prompt=Search
width=480
location=center
orientation=vertical
halign=fill
content_halign=fill

# rofi/config.rasi: listview { lines: 8; columns: 1; }
columns=1
lines=8

hide_scroll=true
insensitive=true

# `contains` instead of `fuzzy`: a substring test per entry rather than a
# fuzzy score per entry. Noticeably faster on a CPU renderer, and for
# launching apps by name the difference in results is small. fuzzel (the
# preferred launcher) does keep fuzzy matching -- it can afford it.
matching=contains

# Both of these cost per-entry work on every redraw:
#   allow_markup -- runs every label through the pango markup parser
#   allow_images -- decodes and scales an icon per row
allow_markup=false
allow_images=false

no_actions=true
term=kitty
gtk_dark=true
key_expand=Tab
