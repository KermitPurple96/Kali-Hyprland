#!/bin/sh
# Keep i3's session entries out of the login screen.
#
# The i3 package reinstates /usr/share/xsessions/i3.desktop on every
# upgrade, so this runs from an APT DPkg::Post-Invoke hook to put them back
# out of the way.
#
# WHY THIS IS A SCRIPT AND NOT A ONE-LINER IN apt.conf.d
#
# It used to be inlined, and it was broken:
#
#   DPkg::Post-Invoke {
#     "for f in ...; do [ -f \"$f\" ] && mv \"$f\" \"$f.disabled\"; done; true";
#   };
#
# APT's config parser does not unescape \" into a double quote the way a
# shell does. `apt-config dump` shows what it actually passes to sh:
#
#   for f in ...; do [ -f \$f\ ] && mv \$f\ \$f.disabled\; done; true
#
# Every \" became a bare backslash, so the `;` before `done` ended up
# escaped, `done` became an argument to `mv`, and the for loop was never
# terminated:
#
#   sh: 1: Syntax error: end of file unexpected (expecting "done")
#   Error: Problem executing scripts DPkg::Post-Invoke
#   Error: Sub-process returned an error code
#
# That made EVERY apt operation exit non-zero -- installs still completed,
# but any script running apt under `set -e` (tools.sh, install.sh) would
# abort. Moving the logic into a file removes the quoting problem entirely.
#
# To stop hiding i3 -- for instance if you want to pick it at the greeter:
#     sudo rm /etc/apt/apt.conf.d/99-keep-i3-disabled
#     sudo /usr/local/sbin/keep-i3-disabled --restore

set -eu

SESSIONS="/usr/share/xsessions/i3.desktop /usr/share/xsessions/i3-with-shmlog.desktop"

if [ "${1:-}" = "--restore" ]; then
    for f in $SESSIONS; do
        [ -f "$f.disabled" ] && mv "$f.disabled" "$f"
    done
    echo "i3 session entries restored."
    exit 0
fi

for f in $SESSIONS; do
    [ -f "$f" ] && mv "$f" "$f.disabled"
done

# Never let this hook fail an apt transaction, whatever happens above.
exit 0
